<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Scato_Reportes_Datasource">
      <DataSourceReference>Scato_Reportes_Datasource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>fcdac5bc-96f6-4cb6-83ee-081bfc842e2b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DSIngreso">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @fecha datetime = @FechaHoy;   


select COALESCE(IngresoxD, m.Descripcion) as IngresoxD,  
COALESCE(CantidadxD, 0) as CantidadxD,
COALESCE(TonsxD, 0) as TonsxD,
COALESCE(CantidadxM, 0) as CantidadxM,
COALESCE(TonsxM, 0) as TonsxM,
COALESCE(CantidadxA, 0) as CantidadxA,
COALESCE(TonsxA, 0) as TonsxA
from MaterialReporteDeMovimientos m
left join (
SELECT CASE 
			when Material_Id = 4 and (case when Establecimiento_Id is null then 1 else 0 end) = 0 then 'Soja Sustentable'
			when Material_Id = 4 and (case when Establecimiento_Id is null then 1 else 0 end) = 1 then 'Soja'
			else m.Descripcion end
			as 'IngresoxD',
 sum(case when r.PesoTaraFecha &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00'  and r.PesoTaraFecha &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59' then 1 else 0 end  ) as 'CantidadxD',
cast(((sum(case when r.PesoTaraFecha &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00'  and r.PesoTaraFecha &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:59:59' then cast(r.PesoBruto- PesoTara as numeric(18,2)) else 0 end) )/1000) as numeric(18,2)) AS 'TonsxD',
 sum(case when r.PesoTaraFecha &gt;= dateadd(month,datediff(month,0,@fecha),0) and r.PesoTaraFecha &lt;= dateadd(day,-1,dateadd(month,datediff(month,-1,@fecha),0)) then 1 else 0 end  ) as 'CantidadxM',
cast(((sum(case when r.PesoTaraFecha &gt;= dateadd(month,datediff(month,0,@fecha),0) and r.PesoTaraFecha &lt;= dateadd(day,-1,dateadd(month,datediff(month,-1,@fecha),0)) then cast(r.PesoBruto- PesoTara as numeric(18,2)) else 0 end) )/1000)  as numeric(18,2))  AS 'TonsxM',
count(*) as 'CantidadxA',cast( (sum(cast(r.PesoBruto- PesoTara as numeric(18,2)))/1000) as numeric(18,2)) as 'TonsxA'
FROM [Recorrido] as r WITH(NOLOCK)
join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id 
join Material as m WITH(NOLOCK) on m.Id = r.Material_Id

where w.TipoDeWorkflow = 0 and r.Centro_Id = @CentroId
and r.PesoTaraFecha is not null and terminado = 1 and Rechazado = 0
and ((MONTH(@fecha) &gt; 3 and r.PesoTaraFecha &gt; DATEFROMPARTS(YEAR(@fecha),4,1)) OR
(MONTH(@fecha) &lt;= 3 and r.PesoTaraFecha &gt; DATEFROMPARTS(YEAR(@fecha)-1,3,31)))

group by m.Descripcion, Material_Id, case when Establecimiento_Id is null then 1 else 0 end
) as Datos on datos.IngresoxD = m.Material
where ingreso = 1
order by orden</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="IngresoxD">
          <DataField>IngresoxD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CantidadxD">
          <DataField>CantidadxD</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TonsxD">
          <DataField>TonsxD</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CantidadxM">
          <DataField>CantidadxM</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TonsxM">
          <DataField>TonsxM</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CantidadxA">
          <DataField>CantidadxA</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TonsxA">
          <DataField>TonsxA</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DSEgreso">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @fecha datetime = @FechaHoy;   


select COALESCE(EgresoxD, m.Descripcion) as EgresoxD,  
COALESCE(CantidadxD, 0) as CantidadxD,
COALESCE(TonsxD, 0) as TonsxD,
COALESCE(CantidadxM, 0) as CantidadxM,
COALESCE(TonsxM, 0) as TonsxM,
COALESCE(CantidadxA, 0) as CantidadxA,
COALESCE(TonsxA, 0) as TonsxA
from MaterialReporteDeMovimientos m
left join (
SELECT 
	m.Descripcion + (CASE 
		when tc.Descripcion like '%Exportacion%'  then ' EXPORTACIÓN'
		when tc.Descripcion like '%Venta%' then ' VENTA'
		when tc.Descripcion like '%Redespacho%' then ' REDESPACHO'
		else '' end) as 'EgresoxD',
	 sum(case when r.PesoBrutoFecha &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00'  and r.PesoBrutoFecha &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:50' then 1 else 0 end  ) as 'CantidadxD',
	cast(((sum(case when r.PesoBrutoFecha &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00'  and r.PesoBrutoFecha &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:50' then cast( r.PesoBruto- PesoTara as numeric(18,2)) else 0 end) )/1000)  as numeric(18,2)) AS 'TonsxD',
	 sum(case when r.PesoBrutoFecha &gt;= dateadd(month,datediff(month,0,@fecha),0) and r.PesoBrutoFecha &lt;= dateadd(day,-1,dateadd(month,datediff(month,-1,@fecha),0)) then 1 else 0 end  ) as 'CantidadxM',
	cast (((sum(case when r.PesoBrutoFecha &gt;= dateadd(month,datediff(month,0,@fecha),0) and r.PesoBrutoFecha &lt;= dateadd(day,-1,dateadd(month,datediff(month,-1,@fecha),0)) then cast( r.PesoBruto- PesoTara as numeric(18,2)) else 0 end) )/1000)  as numeric(18,2))AS 'TonsxM',
	count(*) as CantidadxA,cast( (sum(cast(r.PesoBruto- PesoTara as numeric(18,2)))/1000) as numeric(18,2)) as 'TonsxA'
FROM [Recorrido] as r WITH(NOLOCK)
join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id 
join Material as m WITH(NOLOCK) on m.Id = r.Material_Id
join TipoComercial as tc WITH(NOLOCK) on tc.Id = r.TipoComercial_Id
where w.TipoDeWorkflow = 1 and  r.Centro_Id = @CentroId
and r.PesoBrutoFecha is not null and terminado = 1 and Rechazado = 0
and ((MONTH(@fecha) &gt; 3 and r.PesoBrutoFecha &gt; DATEFROMPARTS(YEAR(@fecha),4,1)) OR
(MONTH(@fecha) &lt;= 3 and r.PesoBrutoFecha &gt; DATEFROMPARTS(YEAR(@fecha)-1,3,31)))
group by m.Descripcion, (CASE 
		when tc.Descripcion like '%Exportacion%'  then ' EXPORTACIÓN'
		when tc.Descripcion like '%Venta%' then ' VENTA'
		when tc.Descripcion like '%Redespacho%' then ' REDESPACHO'
		else '' end)
		) as Datos on datos.EgresoxD = m.Material
where ingreso = 0
order by orden</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="EgresoxD">
          <DataField>EgresoxD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CantidadxD">
          <DataField>CantidadxD</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TonsxD">
          <DataField>TonsxD</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CantidadxM">
          <DataField>CantidadxM</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TonsxM">
          <DataField>TonsxM</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CantidadxA">
          <DataField>CantidadxA</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TonsxA">
          <DataField>TonsxA</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DTAlamacen">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @fecha datetime = @FechaHoy;   


select  a.Descripcion, cast(sum(cast(r.PesoBruto-r.PesoTara as numeric(18,2)))/1000  as numeric(18,2))as Toneladas ,max(m.Descripcion) as Operacion FROM [Recorrido] as r WITH(NOLOCK)
join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id 
join Almacen as a WITH(NOLOCK)
on a.Id = r.Almacen_Id 
join Material as m WITH(NOLOCK)
on m.Id= r.Material_Id 
where w.TipoDeWorkflow = 1 and r.Centro_Id = @CentroId  and terminado = 1 and Rechazado = 0 and r.PesoBrutoFecha is not null and r.PesoBrutoFecha &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00' and r.PesoBrutoFecha &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:50'
group by a.Descripcion</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Toneladas">
          <DataField>Toneladas</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Operacion">
          <DataField>Operacion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DTDescarga">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @fecha datetime = @FechaHoy;   


select a.Descripcion, m.descripcion as Material,count(r.Id) as Camiones , sum(r.PesoBruto-r.PesoTara) as Kilogramos, a.Descripcion as 'Celda/Tankes' FROM [Recorrido] as r WITH(NOLOCK)
join Almacen as a WITH(NOLOCK) on a.Id = r.Almacen_Id 
join Material as m WITH(NOLOCK) on m.Id = r.material_id 
join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id 
where w.TipoDeWorkflow = 0  and r.Centro_Id = @CentroId  and terminado = 1 and Rechazado = 0
and r.PesoTaraFecha is not null and r.PesoTaraFecha &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00'  and r.PesoTaraFecha &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:50'
group by a.Descripcion , m.descripcion</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Camiones">
          <DataField>Camiones</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Kilogramos">
          <DataField>Kilogramos</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Celda_Tankes">
          <DataField>Celda/Tankes</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DTCarga">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @fecha datetime = @FechaHoy;   


select a.Descripcion, m.descripcion as Material,count(r.Id) as Camiones , sum(r.PesoBruto-r.PesoTara) as Kilogramos, a.Descripcion as 'Celda/Tankes' FROM [Recorrido] as r WITH(NOLOCK)
join Almacen as a WITH(NOLOCK) on a.Id = r.Almacen_Id 
join Material as m WITH(NOLOCK) on m.Id = r.material_id
join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id 
where w.TipoDeWorkflow = 1  and r.Centro_Id = @CentroId  and terminado = 1 and Rechazado = 0
and r.PesoBrutoFecha is not null and r.PesoBrutoFecha &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00' and r.PesoBrutoFecha &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:50'
group by a.Descripcion , m.descripcion</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Descripcion">
          <DataField>Descripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Camiones">
          <DataField>Camiones</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Kilogramos">
          <DataField>Kilogramos</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Celda_Tankes">
          <DataField>Celda/Tankes</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DSTotaldelDia">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @fecha datetime = @FechaHoy;   

select count(*) as Total 
FROM [Recorrido] as r WITH(NOLOCK)
where    r.FechaInicio &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00' 
	and r.FechaInicio &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:50'
	and terminado = 1 and Rechazado = 0  and r.Centro_Id = @CentroId</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Total">
          <DataField>Total</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT Centro.CodigoSap as CentroSapp,
              Centro.Descripcion as CentroDescripcion

FROM [Centro] as Centro WITH (NOLOCK)

WHERE Centro.Id = @CentroId</CommandText>
      </Query>
      <Fields>
        <Field Name="CentroSapp">
          <DataField>CentroSapp</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CentroDescripcion">
          <DataField>CentroDescripcion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Img">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <CommandText>Select Top 1 Logo from Firma</CommandText>
      </Query>
      <Fields>
        <Field Name="Logo">
          <DataField>Logo</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DSDescargaCamionVagon">
      <Query>
        <DataSourceName>Scato_Reportes_Datasource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaHoy">
            <Value>=Parameters!FechaHoy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CentroId">
            <Value>=Parameters!CentroId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @fecha datetime = @FechaHoy;   

select a.Descripcion as Almacen, m.descripcion as Material,
count(case when TipoVehiculo != 1 then 1 else null end) as CantCamiones,
count(case when TipoVehiculo = 1 then 1 else null end) as CantTrenes,

cast(sum(cast( case when r.TipoVehiculo != 1 then r.PesoBruto-r.PesoTara else 0 end as numeric(18,2)))/1000 as numeric(18,2))as ToneladasCamiones
,
cast(sum(cast( case when r.TipoVehiculo = 1 then r.PesoBruto-r.PesoTara else 0 end as numeric(18,2)))/1000 as numeric(18,2))as ToneladasTren

FROM [Recorrido] as r WITH(NOLOCK)
join Workflow as w WITH(NOLOCK) on r.Workflow_Id = w.Id 
join Almacen as a WITH(NOLOCK) on a.Id = r.Almacen_Id
join Material as m WITH(NOLOCK) on m.Id = r.material_id 
where w.TipoDeWorkflow = 0 
and r.Centro_Id = @CentroId  
and r.Material_Id IN( 4,386,1)
and terminado = 1 
and Rechazado = 0 
and r.PesoTaraFecha is not null 
and r.PesoTaraFecha &gt;= dateadd(day, datediff(day, 0, @fecha), 0) + '00:00' 
and r.PesoTaraFecha &lt;= dateadd(day, datediff(day, 0, @fecha), 0) + '23:50'
group by a.Descripcion, m.descripcion
</CommandText>
      </Query>
      <Fields>
        <Field Name="Almacen">
          <DataField>Almacen</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CantCamiones">
          <DataField>CantCamiones</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CantTrenes">
          <DataField>CantTrenes</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ToneladasCamiones">
          <DataField>ToneladasCamiones</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ToneladasTren">
          <DataField>ToneladasTren</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
