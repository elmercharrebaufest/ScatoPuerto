<parameters>
  <parameter name="ServicioRepositorio Service Endpoint Address">
    <parameterEntry kind="XmlFile" scope="Web.config"
                    match="/configuration/system.serviceModel/client
                           /endpoint[@name='ServicioRepositorio']
                           /@address" />
  </parameter>
  <parameter name="FirmaProvider Service Endpoint Address">
    <parameterEntry kind="XmlFile" scope="Web.config"
                    match="/configuration/system.serviceModel/client
                           /endpoint[@name='FirmaProvider']
                           /@address" />
  </parameter>
  <parameter name="ServicioComandos Service Endpoint Address">
    <parameterEntry kind="XmlFile" scope="Web.config"
                    match="/configuration/system.serviceModel/client
                           /endpoint[@name='ServicioComandos']
                           /@address" />
  </parameter>
  <parameter name="ListaDeWorkflows Service Endpoint Address">
    <parameterEntry kind="XmlFile" scope="Web.config"
                    match="/configuration/system.serviceModel/client
                           /endpoint[@name='ListaDeWorkflows']
                           /@address" />
  </parameter>
	
  <parameter name="WebPuertoApiUsername Config">
	 <parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='WebPuertoApiUsername']
                           /@value" />
  </parameter>
  <parameter name="ZebraPrinterIp Config">
   <parameterEntry kind="XmlFile" scope="Web.config"
          match="/configuration/appSettings/add[@key='ZebraPrinterIp']
                           /@value" />
  </parameter>
  <parameter name="WebPuertoApiPassword Config">
	 <parameterEntry kind="XmlFile" scope="Web.config"
						match="/configuration/appSettings/add[@key='WebPuertoApiPassword']
                           /@value" />
  </parameter>
</parameters>
