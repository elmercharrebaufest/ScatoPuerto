@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.WebMobile.Helpers
@model Molinos.Scato.Dominio.Dto.GraficoEficienciaHidraulicasDto
@{
    ViewBag.Title = Textos.GraficoDePlanta_Titulo;
}
<div id="links"
     data-url-buscar-material="@Url.Action("BuscarMaterial", "Consultas")"
     data-url-buscar-materiales="@Url.Action("BuscarMateriales", "Consultas")">
</div>
<script type="text/javascript" src="@Url.Script("~/scripts/graficoEficienciaHidraulicas.js")"></script>
<script type="text/javascript">
    var textoHidraulicas = "@Textos.CantidadCamionesPorHidraulicaJavascript"
</script>

<br />
<div id="graficoeficienciahidraulica" class="col border rounded panel-padding">
    <form id="formHidraulica">
        <div class="form-row">
            <div class="col-12 col-sm h5 mt-auto  text-center">
                @Textos.EficienciaHidraulicas
            </div>
            <div class="col-12 col-sm m-auto">
                @Html.TextBoxFor(model => model.MaterialDescripcion, new { @class = "form-control", @id = "materialDescripcionHidraulica" })
                @Html.ValidationMessageFor(model => model.MaterialDescripcion)
                @Html.HiddenFor(model => model.MaterialId, new { @id = "materialIdHidraulica" })
            </div>
            <div class="col-12 col-sm m-auto">
                @Html.LabelFor(model => model.Fecha, new { @class = "sr-only" })
                <div class="input-group date ancho-maximo">
                    @Html.EditorFor(model => model.Fecha, Model != null ? Model.Fecha.FormattedFixed() : string.Empty)
                </div>
                @Html.ValidationMessageFor(model => model.Fecha)
            </div>
            <div class="col-12 col-sm m-auto">
                <button class="btn btn-outline-success w-100" data-bind="click: generarGrafico">@Textos.Generar</button>
            </div>
        </div>
    </form>
    <div class="row" id="partialContainerHidraulica">
        @Html.Partial("_GraficoEficienciaHidraulicas", Model)
    </div>
</div>