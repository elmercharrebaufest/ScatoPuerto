@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.WebMobile.Helpers
@using System.Web.Optimization

@model List<EstadoMaterialDto>
@{
    ViewBag.Title = Textos.GraficoDePlanta_Titulo;
    var camaras = (IList<string>)ViewBag.Camaras;
    Layout = null;
}

@Styles.Render("~/Content/bootstrap")
@Styles.Render("~/Content/css")
@Styles.Render("~/Content/themes/base/css")
@Scripts.Render("~/bundles/jquery-common")
@Scripts.Render("~/bundles/bootstrap")
<style>
    .content {
        padding-top: 15px;
        background: #f2f3f8;
        height:100vh;
    }

    img {
        width: 100%;
        height: 100%;
    }
</style>


<script src="~/Scripts/knockout-2.2.1.js" type="text/javascript"></script>
<script src="~/Scripts/Chart.js" type="text/javascript"></script>
<script src="~/Scripts/Chart.bundle.js"></script>
<script src="~/Scripts/chartjs-plugin-annotation.min.js"></script>
<script>
    urlEstadoDePlanta = '@Url.Action("EstadoDePlanta")';
</script>
<script type="text/javascript" src="@Url.Script("~/scripts/graficosCupoTvIndex.js")"></script>
<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div id="estadodePlanta">
                    @Html.Action("EstadoDePlanta")
                </div>
                <div class="row row-card-no-pd" style=" height: 22vh; ">
                    @foreach (var c in camaras)
                    {
                        <div class="col-sm-2" style="display:flex;">
                            <img src="@c" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>