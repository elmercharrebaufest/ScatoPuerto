@using Molinos.Scato.Web.Helpers
@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.ReciboMunicipalDto
@Html.ValidationSummary(true)



@Html.HiddenFor(model => model.Id)
@Html.HiddenFor(model => model.CentroId)

<div class="control-group">
    @Html.LabelFor(model => model.Monto, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.Monto, new { @class = "control input-medium numero" })
        @Html.ValidationMessageFor(model => model.Monto)
    </div>
</div>
<div class="control-group FechaActivacion">
    @Html.LabelFor(model => model.FechaActivacion, new { @class = "control-label" })
    <div class="controls">
        @Html.EditorFor(model => model.FechaActivacion, Model != null ? Model.FechaActivacion.Formatted() : string.Empty, new { style = "width:90px" })
        @Html.ValidationMessageFor(model => model.FechaActivacion)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Ordenanza, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.Ordenanza, new { @class = "control input-large" })
        @Html.ValidationMessageFor(model => model.Ordenanza)
    </div>
</div>

