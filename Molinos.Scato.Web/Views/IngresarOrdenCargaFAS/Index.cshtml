@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@{
    ViewBag.Title = Textos.OrdenCargaFAS_Titulo;
    var workflow = (string) ViewBag.Workflow;
}
@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")   
    <script type="text/javascript" src="@Url.Content("~/scripts/jquery.maskedinput.js")"></script>
    <script src="@Url.Script("~/Scripts/autocompletar.js")" type="text/javascript"></script>
    <script src="@Url.Script("~/Scripts/ordenCargaFas.js")" type="text/javascript"></script>
    @*    <script type="text/javascript" src="@Url.Script("~/scripts/validarCuil.js")"></script>*@
}
<style>
 .content { padding-top: 20px;}

</style>
<div class ="container-fluid">
    <div class="titSecciones">@Textos.Workflow_Nombre - @Textos.OrdenCargaFAS_Titulo</div>
</div>

@using (Html.BeginForm("Index", "IngresarOrdenCargaFas", new { workflow }, FormMethod.Post, new { @class = "form-horizontal content container causaBlock", id = "orden-form", onsubmit = "AceptarFormulario()", data_mensaje_espera = Textos.ActIngresarOrdenDeCargaFas }))
{
    if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
     {
         <div class="alert alert-error">
             @Html.ValidationSummary(true)
         </div>
     }
    @Html.Partial("_Orden")

    <div class="control-group paddingRight cajaButtons">
        <button class="btn btn-primary" type="submit">@Textos.Aceptar</button>
        @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones",null, new {@class="btn"})
    </div>
}