@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.GraficoEficienciaHidraulicasDto
@{
    ViewBag.Title = Textos.GraficoDePlanta_Titulo;
    Layout = null;
}

<script type="text/javascript" src="@Url.Script("~/scripts/graficoEficienciaHidraulicas.js")"></script>
<script type="text/javascript">
    var textoHidraulicas = "@Textos.CantidadCamionesPorHidraulicaJavascript"
</script>

<div id="graficoeficienciahidraulica">
    <div class="row">
        <div class="col-lg-12 bordeGris">
            <div class="form-inline col-lg-offset-1" style="padding: 5px">
                @Html.LabelFor(model => model.MaterialDescripcion)
                @Html.TextBoxFor(model => model.MaterialDescripcion, new {@class = "input-medium", @id = "materialDescripcionHidraulica"})
               
                @Html.HiddenFor(model => model.MaterialId, new {@id = "materialIdHidraulica"})
                &nbsp;&nbsp;
                @Html.LabelFor(model => model.Fecha)
                @Html.EditorFor(model => model.Fecha, Model != null ? Model.Fecha.FormattedFixed() : string.Empty)
               
                &nbsp;&nbsp;
                <button class="btn" data-bind="click: generarGrafico">@Textos.Generar</button>
            </div>
        </div>
    </div>
    <div class="row" id="partialContainerHidraulica">
        @Html.Partial("_GraficoEficienciaHidraulicas", Model)
    </div>
</div>
<div id="autocompleteCorr"></div>