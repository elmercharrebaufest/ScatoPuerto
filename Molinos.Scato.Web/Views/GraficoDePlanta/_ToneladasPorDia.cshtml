@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.GraficoEficienciaHidraulicasDto
@{
    ViewBag.Title = Textos.GraficoDePlanta_Titulo;
    Layout = null;
}

<script type="text/javascript" src="@Url.Script("~/scripts/graficoToneladasPorDia.js")"></script>
<script type="text/javascript">
    var textoToneladasPorDia = "@Textos.ToneladasPorDia"
</script>

<div id="graficoToneladasPorDia">
    <div class="row">
        <div class="col-lg-12 bordeGris">
            <div class="form-inline col-lg-offset-1" style="padding: 5px">
                @Html.LabelFor(model => model.MaterialDescripcion)
                @Html.TextBoxFor(model => model.MaterialDescripcion, new { @class = "input-medium", @id = "materialDescripcionToneladasPorDia" })
                @Html.ValidationMessageFor(model => model.MaterialDescripcion)
                @Html.HiddenFor(model => model.MaterialId, new { @id = "materialIdToneladasPorDia" })
                &nbsp;&nbsp;
                @Html.LabelFor(model => model.Fecha)
                @Html.EditorFor(model => model.Fecha, Model != null ? Model.Fecha.FormattedFixed() : string.Empty, "FechaToneladasPorDia")
                @Html.ValidationMessageFor(model => model.Fecha)
                &nbsp;&nbsp;
                <button class="btn" data-bind="click: generarGraficoToneldasPorDia">@Textos.Generar</button>
            </div>
        </div>
    </div>
    <div class="row" id="partialContainerToneladasPorDia">
        @Html.Partial("_GraficoToneladasPorDia", Model)
    </div>
</div>
<div id="autocompleteCorr"></div>