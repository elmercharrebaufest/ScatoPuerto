@using Molinos.Scato.Dominio.Recursos
@model Molinos.Scato.Dominio.Dto.PuestoDeTrabajoDto

@{
    var lectores = (IEnumerable<SelectListItem>)ViewBag.Lectores;
    var barreras = (IEnumerable<SelectListItem>)ViewBag.Barreras;
    var camaras = (IEnumerable<SelectListItem>)ViewBag.Camaras;
    var sensores = (IEnumerable<SelectListItem>)ViewBag.Sensores;
    var lectoresQr = (IEnumerable<SelectListItem>)ViewBag.lectoresQr;
    var cartelesLed = (IEnumerable<SelectListItem>)ViewBag.CartelesLed;
}
<style>
    .validation-summary-errors {
        color: #ff0000;
    }
</style>

@*Get*@
@*@Html.Hidden("barrerasJson", (string)ViewBag.BarrerasJson, new {id = "BarrerasJson"})*@
@Html.Hidden("BarrerasEntradaSupervisorGet", (string)ViewBag.EntradaSupervisor, new { id = "BarrerasEntradaSupervisorGet" })
@Html.Hidden("BarrerasEntradaGet", (string)ViewBag.Entrada, new { id = "BarrerasEntradaGet" })
@Html.Hidden("videoCamarasJson", Model == null ? "[]" : Model.VideoCamarasJson, new { id = "videoCamarasFinales" })
@*Post*@
@Html.HiddenFor(model => Model.Id)

@Html.HiddenFor(model => Model.SinAfip)
@Html.HiddenFor(model => Model.SinCupo)
@Html.HiddenFor(model => Model.SinFotoCartaPorte)
@Html.HiddenFor(model => Model.ImprimeCartaPorte)

<input type="hidden" name="barrerasEntradaSupervisor" id="barrerasEntradaSupervisor" data-bind="value: ko.toJSON(barreras)" />
<input type="hidden" name="barrerasEntrada" id="barrerasEntrada" data-bind="value: ko.toJSON(barrerasEntrada)" />

@Html.ValidationSummary(true)
<div class="control-group">
    @Html.LabelFor(model => model.NombrePuesto, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.NombrePuesto, new { @class = "input-large" })
        @Html.ValidationMessageFor(model => model.NombrePuesto)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Lector, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.Lector, lectores)
        @Html.ValidationMessageFor(model => model.Lector)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Entrada, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownList("entradaDropDown", barreras, new { @class = "control ", id = "barreraEntrada" })
        <button class="btn btn-primary" type="button" data-bind="click: addEntrada">@Textos.Agregar</button>
        @Html.ValidationMessageFor(model => model.Entrada)
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>@Textos.Descripcion</th>
                    <th style="width: 30px"></th>
                </tr>
            </thead>
            <tbody data-bind="foreach: barrerasEntrada">
                <tr>
                    <td data-bind="text: Descripcion" />
                    <td><a href="#" data-bind="click: $root.removeEntrada"><i class="icon-trash"></i></a></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="control-group" id="barreras">
    @Html.LabelFor(model => model.EntradaSupervisor, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownList("supervsorDropDown", barreras, new { @class = "control ", id = "barrera" })
        <button class="btn btn-primary agregar" type="button" data-bind="click: addEntradaSupervisor">@Textos.Agregar</button>
        @Html.ValidationMessageFor(model => model.EntradaSupervisor)
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>@Textos.Descripcion</th>
                    <th style="width: 30px"></th>
                </tr>
            </thead>
            <tbody data-bind="foreach: barreras">
                <tr>
                    <td data-bind="text: Descripcion" />
                    <td><a href="#" data-bind="click: $root.removeEntradaSupervisor"><i class="icon-trash"></i></a></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="control-group">
    @Html.LabelFor(model => model.SensorQuiebre, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.SensorQuiebre, sensores, "")
        @Html.ValidationMessageFor(model => model.SensorQuiebre)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.VideoCamara, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.VideoCamara, camaras, "")
        @Html.ValidationMessageFor(model => model.VideoCamara)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.VideoCamaraDirectorio, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.VideoCamaraDirectorio, new { @class = "control input-large" })
        @Html.ValidationMessageFor(model => model.VideoCamaraDirectorio)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.LectorQr, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.LectorQr, lectoresQr, "")
        @Html.ValidationMessageFor(model => model.LectorQr)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.CartelLed, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownListFor(model => model.CartelLed, cartelesLed, "")
        @Html.ValidationMessageFor(model => model.CartelLed)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.VideoCamaras, new { @class = "control-label" })
    <div class="controls">
        @Html.DropDownList("VideoCamara", camaras, new { id = "videoCamara", @class = "control input-xlarge" })
        @Html.TextBox("VideoCamaraDirectorio", null, new { id = "videoCamaraDirectorio", placeholder = Textos.ActividadPorDispositivo_Directorio, @class = "control input-xlarge", style = "width:256px" })
        @Html.ValidationMessageFor(m => m.VideoCamaras)
        <button class="btn btn-primary" type="button" data-bind="click: addVideoCamara">@Textos.Agregar</button>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>@Textos.Descripcion</th>
                    <th>@Textos.ActividadPorDispositivo_Directorio</th>
                    <th></th>
                </tr>
            </thead>
            <tbody data-bind="foreach: videoCamaras">
                <tr>
                    <td data-bind="text: Codigo" />
                    <td data-bind="text: Directorio" />
                    <td><a href="#" data-bind="click: $root.removeVideoCamara"><i class="icon-trash"></i></a></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="control-group">
    @Html.LabelFor(model => model.NombrePc, new { @class = "control-label" })
    <div class="controls">
        @Html.TextBoxFor(model => model.NombrePc, new { @class = "input-large" })
        @Html.ValidationMessageFor(model => model.NombrePc)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.PidePatente, new { @class = "control-label" })
    <div class="controls">
        @Html.CheckBoxFor(model => model.PidePatente, new { @class = "input-large" })
        @Html.ValidationMessageFor(model => model.PidePatente)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.Automatizado, new { @class = "control-label" })
    <div class="controls">
        @Html.CheckBoxFor(model => model.Automatizado, new { @class = "input-large", data_toggle = "tooltip", title = "En Lista de Tareas Automatizada y en Pesada una vez que tiene los datos y son correctos hace el submit automaticamene, si hay un error muestra mensaje y espera que el usuario haga algo." })
        @Html.ValidationMessageFor(model => model.Automatizado)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.ImprimeTarjetaDeAcceso, new { @class = "control-label" })
    <div class="controls">
        @Html.CheckBoxFor(model => model.ImprimeTarjetaDeAcceso, new { @class = "input-large" })
        @Html.ValidationMessageFor(model => model.ImprimeTarjetaDeAcceso)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.EncolaLecturas, new { @class = "control-label" })
    <div class="controls">
        @Html.CheckBoxFor(model => model.EncolaLecturas, new { @class = "input-large" })
        @Html.ValidationMessageFor(model => model.EncolaLecturas)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.FotoAlMarcarTarjeta, new { @class = "control-label" })
    <div class="controls">
        @Html.CheckBoxFor(model => model.FotoAlMarcarTarjeta, new { @class = "input-large" })
        @Html.ValidationMessageFor(model => model.FotoAlMarcarTarjeta)
    </div>
</div>
<div class="control-group">
    @Html.LabelFor(model => model.InvisibleEnListaDeTareas, new { @class = "control-label" })
    <div class="controls">
        @Html.CheckBoxFor(model => model.InvisibleEnListaDeTareas, new { @class = "input-large" })
        @Html.ValidationMessageFor(model => model.InvisibleEnListaDeTareas)
    </div>
</div>

