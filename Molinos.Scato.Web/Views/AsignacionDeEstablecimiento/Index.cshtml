@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers
@model Molinos.Scato.Dominio.Dto.AsignacionDeEstablecimientoDto
@{
    ViewBag.Title = Textos.ActAsignacionDeEstablecimiento;
    var hayErrores = (bool)ViewBag.HayErrores;
    var establecimientos = (IEnumerable<SelectListItem>)ViewBag.Establecimientos;
}
@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}
<div id="links"
     data-url-procedencia-es-igual-a-localidad="@Url.Action("ProcedenciaCartaPorteIgualALocalidadEstablecimiento", "AsignacionDeEstablecimiento")"></div>

<script>
    jQuery(document).ready(function ($) {
        if ($("#foto1").length > 0) {
            $('#fotoDiv').css('display', 'inline');
            $('.ocultar').hide();
        }
    });
</script>
<script type="text/javascript" src="@Url.Script("~/scripts/asignacionDeEstablecimiento.js")"></script>
<style>
    #errorProcedenciaLocalidad {
        color: #ff0000;
    }
</style>



<div class="container-fluid">
    <div class="row-fluid">
        <div class="span6">


            @Html.Hidden("hayErrores", hayErrores)
            @using (Html.BeginForm("Index", "AsignacionDeEstablecimiento", FormMethod.Post, new { @class = "form-horizontal causaBlock", data_mensaje_espera = Textos.ActAsignacionDeEstablecimiento }))
            {
                @Html.HiddenFor(m => m.InstanceId, new { @class = "", id = "InstanciaWorkflow" })
                @Html.HiddenFor(m => m.WorkflowDefinicionId)
                @Html.HiddenFor(m => m.Workflow)
                @Html.HiddenFor(m => m.TipoVehiculo)
                if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Any())
                {
                    <div class="alert alert-error">
                        @Html.ValidationSummary(true)
                    </div>
                }
                <div class="container-fluid">
                    <div class="titSecciones">@Textos.AsignacionDeEstablecimiento_Titulo</div>
                </div>
                <br />@*

            <div class="">
                <p id="errorProcedenciaLocalidad">@Textos.ProcedenciaDistintaAEstablecimiento</p>
            </div>*@
                <div class="row-fluid">
                    <div class="control-group">
                        @Html.LabelFor(model => model.Proveedor, new { @class = "control-label" })
                        <div>
                            @Html.DisplayFor(model => model.Proveedor, new { @class = "control" })
                        </div>
                    </div>

                    <div class="control-group">
                        @Html.LabelFor(model => model.EstablecimientoId, new { @class = "control-label" })
                        <div>
                            @Html.DropDownListFor(model => model.EstablecimientoId, establecimientos, String.Empty, new { @class = "control input-xlarge", id = "dropdownEstablecimientos" })
                            @Html.ValidationMessageFor(model => model.EstablecimientoId)
                        </div>
                    </div>
                </div>
                <div class="row-fluid">
                    <div class="col-md-12" style="margin-top:15px">
                        @Html.ActionLink(Textos.ModificarDocumento, "Seleccionar", "ModificarDocumentoDeIngreso", new { id = ViewBag.RecorridoId, soloLectura = false }, new { target = "_blank", @class = "btn" })
                        <span>&nbsp;</span>
                        <button type="submit" class="btn btn-primary" id="BotonAceptar">@Textos.Aceptar</button>
                        @Html.ActionLink(Textos.Rechazar, "Rechazar", "AsignacionDeEstablecimiento", new { codigoWf = Model.Workflow, workflowDefinicionId = Model.WorkflowDefinicionId, instanceId = Model.InstanceId }, new { @class = "rechazar-boton btn btn-primary", id = "btnRechazar" })
                        <span>&nbsp;</span>
                        @Html.ActionLink(Textos.Cancelar, "Index", "ListaDeCamiones", null, new { @class = "btn" })
                    </div>
                </div>
                <br />
                <div class="row-fluid">
                    <div class="span12">
                        <div class="alert alert-danger hide" id="errorProcedenciaLocalidad">
                            <div id="validation-danger">
                                @Textos.ProcedenciaDistintaAEstablecimiento
                            </div>
                        </div>
                    </div>
                </div>

            }


        </div>
        <div class="span6 control-group control-group-no-bottom borde ocultar fondo">
            No se encontró la foto para la CCPP
        </div>
        <div class="span6 control-group control-group-no-bottom sinBorde" id="fotoDiv">
            @if (ViewBag.FotoMesaDigitalizacion1 != null)
            {
                <img id="foto1" src="@("data:image/jpeg;base64," + Convert.ToBase64String((byte[])ViewBag.FotoMesaDigitalizacion1))">

            }
            <img src="" id="place-holder-1" style="margin-left: -1200px; position: absolute; z-index: 100;" />
        </div>
    </div>
</div>






<div id="mensajeRechazar"></div>
