@using Molinos.Scato.Dominio.Consultas
@using Molinos.Scato.Dominio.Dto
@using Molinos.Scato.Dominio.Recursos
@using Molinos.Scato.Web.Helpers

@{
    Layout = null;
    var items = (ListaPaginada<UsuarioDto>)ViewBag.Items;
}

<script src="@Url.Script("~/Scripts/material.listarMateriales.js")" type="text/javascript"></script>


<style>
    .tip {
        max-width: 500px;
        white-space: normal;
    }
</style>
<div id="contenedormatriculamodificar">

    @Html.Grilla(items,
                 grid => grid.Columns(
                    grid.ColumnaModificar(Html, "AvisoDeQuiebre"),
                    grid.Columna("Nombre", Textos.Chofer_Nombre),
                    grid.Columna("Apellido", Textos.Chofer_Apellido),
                    grid.Columna("NombreUsuario", Textos.Usuario_NombreUsuario),
                    grid.Columna("AvisoQuiebreApertura", Textos.AvisoDeQuiebreApertura, m => ((bool)m.AvisoQuiebreApertura).Formatted()),
                    grid.Columna("AvisoQuiebreCierre", Textos.AvisoDeQuiebreCierre, m => ((bool)m.AvisoQuiebreCierre).Formatted()),
                    grid.Columna("ReasignacionDeTarjeta", Textos.ReasignacionDeTarjeta, m => ((bool)m.ReasignacionDeTarjeta).Formatted()),
                    grid.Columna("AvisoAutorizarTiempoEnTransito", Textos.AvisoAutorizarTiempoEnTransito, m => ((bool)m.AvisoAutorizarTiempoEnTransito).Formatted()),
                    grid.Columna("AvisoAutorizarTiempoEnTransitoConfirmado", Textos.AvisoAutorizarTiempoEnTransitoConfirmado, m => ((bool)m.AvisoAutorizarTiempoEnTransitoConfirmado).Formatted()),
                    grid.Columna("AvisoAutorizarTiempoEnTransitoRechazado", Textos.AvisoAutorizarTiempoEnTransitoRechazado, m => ((bool)m.AvisoAutorizarTiempoEnTransitoRechazado).Formatted()),
                    grid.Columna("AvisoContingencia", Textos.AvisoContingencia, m => ((bool)m.AvisoContingencia).Formatted()),
                    grid.Columna("AvisoLineUp", Textos.AvisoLineUp, m => ((bool)m.AvisoLineUp).Formatted()),
                    grid.Columna("AvisoPlanoDeCarga", Textos.AvisoPlanoDeCarga, m => ((bool)m.AvisoPlanoDeCarga).Formatted()),
                    grid.Columna("AvisoModuloDeCarga", Textos.AvisoModuloDeCarga, m => ((bool)m.AvisoModuloDeCarga).Formatted())

    ))
</div> 